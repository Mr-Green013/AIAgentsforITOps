{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "ManagedIdentity": {
    "ClientId": ""
  },

  "AzureSearch": {
    "Endpoint": "https://${AZURE_SEARCH_NAME}.search.windows.net",
    "IndexName": "conference-documents"
  },

  "AzureStorage": {
    "BlobEndpoint": "https://${STORAGE_ACCOUNT_NAME}.blob.core.windows.net",
    "ContainerName": "conference-data"
  },

  "KeyVault": {
    "VaultUri": "https://${KEY_VAULT_NAME}.vault.azure.net/"
  },

  "Foundry": {
    "ProjectEndpoint": "${FOUNDRY_PROJECT_ENDPOINT}",
    "AgentName": "conference-expert-agent",
    "ModelDeploymentName": "gpt-4o"
  },

  "AIProviders": {
    "Order": [ "AzureOpenAI", "Anthropic", "Gemini" ],
    "MaxAttemptsPerProvider": 2,
    "InitialRetryDelayMs": 500,
    "MaxRetryDelayMs": 8000,
    "RequestTimeoutSeconds": 60,

    "AzureOpenAI": {
      "Enabled": true,
      "DeploymentName": "gpt-4.1-mini"
    },

    "Anthropic": {
      "Enabled": true,
      "Model": "claude-opus-5",
      "BaseUrl": "https://api.anthropic.com",
      "ApiVersion": "2023-06-01",
      "SendTemperature": false,
      "ApiKey": ""
    },

    "Gemini": {
      "Enabled": true,
      "Model": "gemini-2.5-flash",
      "BaseUrl": "https://generativelanguage.googleapis.com",
      "ApiVersion": "v1beta",
      "ApiKey": ""
    }
  },

  "ApplicationInsights": {
    "ConnectionString": "${APPLICATIONINSIGHTS_CONNECTION_STRING}"
  }
}
