{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },

  "AzureSearch": {
    "Endpoint": "https://localhost:7777",
    "IndexName": "conference-documents"
  },

  "AzureStorage": {
    "BlobEndpoint": "https://localhost:10000/devstoreaccount1",
    "ContainerName": "conference-data"
  },

  "KeyVault": {
    "VaultUri": "https://localhost:8200"
  },

  "Foundry": {
    "ProjectEndpoint": "",
    "AgentName": "conference-expert-agent",
    "ModelDeploymentName": "gpt-4o"
  },

  "AIProviders": {
    "Order": [ "AzureOpenAI", "Anthropic", "Gemini" ],
    "MaxAttemptsPerProvider": 2,
    "RequestTimeoutSeconds": 30,

    "AzureOpenAI": {
      "DeploymentName": "gpt-4.1-mini"
    },

    "Anthropic": {
      "Model": "claude-opus-5",
      "ApiKey": ""
    },

    "Gemini": {
      "Model": "gemini-2.5-flash",
      "ApiKey": ""
    }
  }
}
